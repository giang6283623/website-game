# Tệp mẫu, liệt kê các biến môi trường của dự án. Bun không tự nạp tệp này.
# Muốn đổi giá trị trên máy của bạn: chép tệp này thành .env.local rồi sửa. .env.local không vào git.
# Ưu tiên từ cao xuống thấp: biến gõ trên dòng lệnh, file .env.local, .env.development hoặc .env.production.
# API_MODE và SITE_URL được nhúng vào gói JavaScript lúc build, nên không đặt khóa bí mật ở đây.

# Nguồn dữ liệu.
# mock: API giả chạy ngay trong trình duyệt, máy chủ chỉ cần phát tệp tĩnh.
# real: gọi /api/v1 trên máy chủ thật.
# mock-server: máy chủ giả có lưu dữ liệu. bun run mock tự đặt giá trị này, không ghi vào đây.
API_MODE=mock

# Địa chỉ công khai của site, dùng cho canonical, og:url và sitemap.xml.
# Viết dạng https://demo.example.com, không có dấu gạch chéo cuối. Để trống thì bỏ cả ba.
SITE_URL=

# Cổng của máy chủ xem thử (bun run serve). Chỉ ảnh hưởng lệnh serve, không ảnh hưởng build.
PORT=4173

# Hai biến dưới đây không bắt buộc. Bỏ dấu # đầu dòng nếu ảnh gốc nằm ở nơi khác.
# Dùng cho bun run build:images và bun run build:art.
# GAME_ASSETS_DIR=game-assets-src
# ART_ASSETS_DIR=art-src
